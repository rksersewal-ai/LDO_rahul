# =============================================================================
# LDO-2 EDMS - Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# Store staging/production values in your deployment platform secret manager.
# Never commit real .env files.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Local:      postgresql://postgres:postgres@localhost:5432/ldo2_edms
# Test/CI:    postgresql://postgres:postgres@localhost:5432/ldo2_edms_test
# Staging:   use a dedicated managed PostgreSQL staging database
# Production: use a dedicated managed PostgreSQL production database or PgBouncer URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ldo2_edms
# POSTGRES_URL can be used by providers that expose this name instead of DATABASE_URL.
# POSTGRES_URL=
# Supabase/managed Postgres aliases. Use POSTGRES_URL_NON_POOLING for migrations when provided.
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWT_SECRET=

# --- Authentication (NextAuth.js/Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-random-32-byte-string-in-production
# NEXTAUTH_SECRET is accepted as a provider-compatible alias.
# NEXTAUTH_SECRET=
# Public callback origin. Use your deployed HTTPS origin in staging/production.
# AUTH_URL=https://edms.example.gov
# NEXTAUTH_URL=https://edms.example.gov
# Set to true only behind a trusted reverse proxy.
# AUTH_TRUST_HOST=true

# --- Redis (optional but recommended for queues/cache/rate limits) ---
REDIS_URL=redis://localhost:6379

# --- File Storage ---
STORAGE_NAS_PATH=./storage

# --- Email (SMTP; optional) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@ldo-edms.local

# --- Database Pool Tuning ---
DB_POOL_MAX=40
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# --- Background Worker Tuning ---
WORKER_LOAD_GATE_ENABLED=true
WORKER_LOAD_GATE_THRESHOLD=0.9
WORKER_LOAD_GATE_STEP_MS=1000
WORKER_LOAD_GATE_MAX_WAIT_MS=30000
OCR_WORKER_CONCURRENCY=2
OCR_JOB_TIMEOUT_MS=300000
OCR_PER_PAGE_MIN_CHARS=50
OCR_NATIVE_MIN_CHARS=100
OCR_RECOGNIZE_TIMEOUT_MS=120000
OCR_WORKER_RECYCLE_AFTER=50
DEDUP_WORKER_CONCURRENCY=1
DEDUP_JOB_TIMEOUT_MS=1800000
DEDUP_MAX_CANDIDATE_PAIRS=100000
DEDUP_MAX_GROUP_SIZE=200
DEDUP_YIELD_EVERY=5000
RETENTION_SCAN_INTERVAL_MS=86400000

# --- Upload Limits ---
DOC_MAX_UPLOAD_BYTES=524288000
DOC_MAX_CONCURRENT_UPLOADS=3
