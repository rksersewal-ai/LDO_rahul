# Copy this file to .env for local development and replace placeholders.
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Required runtime services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ldo_rahul
REDIS_URL=redis://localhost:6379

# Optional local file storage root
STORAGE_PATH=./storage
