# =============================================================================
# LDO-2 EDMS - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for local development.
# For production, set these as environment variables in your deployment platform.
# =============================================================================

# --- Database ---
# PostgreSQL connection string (required in production, defaults to local dev DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ldo2_edms

# --- Authentication (NextAuth.js) ---
# Secret used to sign/encrypt session tokens (must be a random 32+ byte string in production)
AUTH_SECRET=change-this-to-a-random-32-byte-string-in-production
# Set to true ONLY when deployed behind a trusted reverse proxy (Nginx, Cloudflare, AWS ALB, etc.)
# Do not enable in local development or when the app is directly exposed to the internet.
# AUTH_TRUST_HOST=true

# --- Redis (optional) ---
# Used for BullMQ job queues (OCR processing, notifications, etc.)
# If not set, queue features will be disabled gracefully
REDIS_URL=redis://localhost:6379

# --- File Storage ---
# Path to NAS or local file storage mount for uploaded documents.
# In production, this should point to a network-attached storage volume.
# NOTE: the storage service reads STORAGE_NAS_PATH (this exact name).
STORAGE_NAS_PATH=./storage

# --- Application URL ---
# The public-facing URL of the application (used for generating links in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (SMTP) ---
# Used for sending notification and password-reset emails.
# If not set, email features will be disabled gracefully.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@ldo-edms.local

# --- Database Pool Tuning (optional) ---
# Override the default pg Pool settings for high-concurrency deployments.
# DB_POOL_MAX=40                      # Max simultaneous connections (default: 40)
# DB_POOL_IDLE_TIMEOUT_MS=30000       # Remove idle clients after N ms (default: 30000)
# DB_POOL_CONNECTION_TIMEOUT_MS=5000  # Fail fast if no connection available within N ms (default: 5000)

# --- Background Worker Tuning (optional) ---
# OCR_WORKER_CONCURRENCY=2            # Parallel OCR jobs (default 2; auto-clamped to CPU cores - 1)
# OCR_JOB_TIMEOUT_MS=300000           # Hard per-job timeout for OCR (default: 5 min)
# DEDUP_WORKER_CONCURRENCY=1          # Parallel dedup scans per worker (default: 1)
# DEDUP_JOB_TIMEOUT_MS=1800000        # Hard per-job timeout for dedup (default: 30 min)
# DEDUP_MAX_CANDIDATE_PAIRS=100000    # Cap on candidate pairs held/scored per scan (memory/CPU bound)
# DEDUP_MAX_GROUP_SIZE=200            # Skip exact/PL groups larger than this when forming candidates
# DEDUP_YIELD_EVERY=5000              # Event-loop yield cadence during long dedup scans
# RETENTION_SCAN_INTERVAL_MS=86400000 # How often the retention-expiry scan runs (default: 24h)

# --- Upload Limits (optional) ---
# DOC_MAX_UPLOAD_BYTES=524288000      # Max upload size in bytes (default: 500MB)
# DOC_MAX_CONCURRENT_UPLOADS=3        # Max simultaneous in-memory uploads (memory backpressure)

